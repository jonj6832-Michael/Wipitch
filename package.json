{
	"name": "wipitch",
	"private": true,
	"version": "0.2.0",
	"type": "module",
	"dependencies": {
		"onnxruntime-web": "file:vendor/onnxruntime-web-1.29.0.tgz",
		"rubberband-wasm": "file:vendor/rubberband-wasm-3.3.0.tgz",
		"tone": "15.1.22"
	},
	"overrides": {
		"onnxruntime-common": "file:vendor/onnxruntime-common-1.29.0.tgz",
		"flatbuffers": "file:vendor/flatbuffers-25.9.23.tgz",
		"guid-typescript": "file:vendor/guid-typescript-1.0.9.tgz",
		"long": "file:vendor/long-5.3.2.tgz",
		"platform": "file:vendor/platform-1.3.6.tgz",
		"protobufjs": "file:vendor/protobufjs-7.6.6.tgz",
		"@protobufjs/aspromise": "file:vendor/protobufjs-aspromise-1.1.2.tgz",
		"@protobufjs/base64": "file:vendor/protobufjs-base64-1.1.2.tgz",
		"@protobufjs/codegen": "file:vendor/protobufjs-codegen-2.0.5.tgz",
		"@protobufjs/eventemitter": "file:vendor/protobufjs-eventemitter-1.1.1.tgz",
		"@protobufjs/fetch": "file:vendor/protobufjs-fetch-1.1.1.tgz",
		"@protobufjs/float": "file:vendor/protobufjs-float-1.0.2.tgz",
		"@protobufjs/path": "file:vendor/protobufjs-path-1.1.2.tgz",
		"@protobufjs/pool": "file:vendor/protobufjs-pool-1.1.0.tgz",
		"@protobufjs/utf8": "file:vendor/protobufjs-utf8-1.1.2.tgz",
		"@types/node": "file:vendor/types-node-22.20.2.tgz",
		"undici-types": "file:vendor/undici-types-6.21.0.tgz"
	},
	"devDependencies": {
		"puppeteer": "25.10.0",
		"signalsmith-stretch": "1.3.2",
		"typescript": "7.0.2",
		"vite": "8.3.0"
	},
	"scripts": {
		"release": "sh tools/release.sh",
		"dev": "vite --host 0.0.0.0 --port 5180 --strictPort",
		"build": "tsc --noEmit && vite build",
		"preview": "vite preview --host 0.0.0.0 --port 5180",
		"check": "tsc --noEmit",
		"verify": "node tools/verify.mjs && node tools/ui-verify.mjs && npm run verify:flatten && npm run verify:formant && npm run verify:slope && npm run verify:stretch",
		"verify:stretch": "node --experimental-strip-types --import ./tools/ts-resolve.mjs spike/timemap-test.mjs && node --experimental-strip-types --import ./tools/ts-resolve.mjs spike/stretch-truth.mjs && node --experimental-strip-types --import ./tools/ts-resolve.mjs spike/stretch-vibrato.mjs",
		"spike": "node --experimental-strip-types spike/final-compare.mjs",
		"verify:flatten": "node --experimental-strip-types --import ./tools/ts-resolve.mjs spike/flatten-truth.mjs",
		"verify:ui": "node tools/ui-verify.mjs",
		"spike:formant": "node --experimental-strip-types --import ./tools/ts-resolve.mjs spike/formant-lag.mjs",
		"verify:formant": "node --experimental-strip-types --import ./tools/ts-resolve.mjs spike/formant-truth.mjs",
		"verify:slope": "node --experimental-strip-types --import ./tools/ts-resolve.mjs spike/slope-limit-test.mjs && node --experimental-strip-types --import ./tools/ts-resolve.mjs spike/gain-lag.mjs"
	},
	"license": "GPL-3.0",
	"description": "瀏覽器裡的單音修音工具（Flex Pitch / Melodyne 單音模式的替代品）"
}
